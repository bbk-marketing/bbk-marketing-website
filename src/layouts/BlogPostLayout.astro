---
import Layout from './Layout.astro';
import { site } from '../data/site';
import { formatDate, estimateReadingTime } from '../utils/date';
import { extractFaqs } from '../utils/faq';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const {
  title,
  description,
  publishDate,
  updatedDate,
  author,
  category,
  heroImage,
  heroImageAlt,
  heroImageWidth,
  heroImageHeight,
} = post.data;
const readingTime = estimateReadingTime(post.body ?? '');

// The only 3 real anchor sections that exist on the homepage today (see
// BusinessGrowthSection.astro, CTAConsultationForm.astro,
// PatientRecruitmentSection.astro) — "Clinical Research Marketing" and
// "Industry Insights" have no dedicated section of their own yet, so they
// fall back to the general consultation form rather than a mismatched anchor.
const ctaByCategory: Record<string, { href: string; heading: string; body: string }> = {
  'Patient Recruitment': {
    href: '/#patient-recruitment',
    heading: 'Ready to talk about participant recruitment?',
    body: 'Talk with BBK about your Study, recruitment goals, and how BBK RPS approaches pre-screening and referrals.',
  },
  'Business Growth': {
    href: '/#business-growth',
    heading: 'Ready to talk about growing your organization?',
    body: 'Talk with BBK about positioning, multi-Site strategy, and business development for your Sites or network.',
  },
};
const cta =
  ctaByCategory[category] ?? {
    href: '/#contact',
    heading: 'Ready to talk about your Study?',
    body: 'Talk with BBK about your recruitment objectives, participating Sites and geographic requirements.',
  };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: { '@type': 'ImageObject', url: `${site.url}/logo.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${site.url}/blog/${post.id}` },
  articleSection: category,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: `${site.url}/blog/${post.id}` },
  ],
};

// Extracted from the post's own raw markdown, never authored separately —
// the schema can only ever say what the rendered FAQ section already says.
const faqs = extractFaqs(post.body ?? '');
const faqJsonLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : null;
---

<Layout
  title={`${title} | BBK Marketing Solutions Blog`}
  description={description}
  ogType="article"
  publishedTime={publishDate.toISOString()}
  ogImage={heroImage}
  ogImageWidth={heroImage ? String(heroImageWidth) : undefined}
  ogImageHeight={heroImage ? String(heroImageHeight) : undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  <article class="post section">
    <div class="container post-container">
      <a href="/blog" class="back-link">&larr; Back to Blog</a>
      <p class="eyebrow">{category}</p>
      <h1>{title}</h1>
      <div class="post-meta">
        <span>{author}</span>
        <span aria-hidden="true">&middot;</span>
        <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
        <span aria-hidden="true">&middot;</span>
        <span>{readingTime} min read</span>
      </div>
      {updatedDate && (
        <p class="post-updated">Updated {formatDate(updatedDate)}</p>
      )}

      {heroImage && (
        <div class="post-hero-image">
          <img src={heroImage} alt={heroImageAlt ?? title} width={heroImageWidth} height={heroImageHeight} />
        </div>
      )}

      <div class="post-body">
        <slot />
      </div>

      <div class="post-cta">
        <h3>{cta.heading}</h3>
        <p>{cta.body}</p>
        <a href={cta.href} class="btn btn-primary">Request a Consultation</a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .post{padding-top:calc(var(--header-h) + 64px)}
  .post-container{max-width:760px}
  .back-link{
    display:inline-block;font-size:.86rem;font-weight:600;color:var(--gray-500);margin-bottom:24px;
    transition:color .2s var(--ease);
  }
  .back-link:hover{color:var(--accent-strong)}

  .post h1{font-size:var(--fs-h2);margin-bottom:18px}
  .post-meta{
    display:flex;align-items:center;gap:8px;font-size:.88rem;color:var(--gray-500);font-weight:500;
    margin-bottom:var(--space-8);
  }
  .post-updated{font-size:.8rem;color:var(--gray-500);margin-top:-24px;margin-bottom:32px;font-style:italic}

  .post-hero-image{
    margin-bottom:var(--space-8);border-radius:var(--radius-lg);overflow:hidden;
    background:var(--gray-100);line-height:0;
  }
  .post-hero-image img{width:100%;height:auto;display:block}

  .post-body :global(h2){font-size:1.35rem;margin-top:var(--space-7);margin-bottom:var(--space-3)}
  .post-body :global(h3){font-size:1.1rem;margin-top:var(--space-6);margin-bottom:var(--space-2)}
  .post-body :global(p){margin-bottom:var(--space-4);line-height:1.8;font-size:1.02rem}
  .post-body :global(ul),.post-body :global(ol){display:flex;flex-direction:column;gap:8px;margin:0 0 var(--space-4);padding-left:22px}
  .post-body :global(li){line-height:1.7;color:var(--text-secondary)}
  .post-body :global(ul li){list-style:disc}
  .post-body :global(ol li){list-style:decimal}
  .post-body :global(a){color:var(--accent-strong);font-weight:600}
  .post-body :global(a:hover){text-decoration:underline}
  .post-body :global(strong){color:var(--text-primary)}
  .post-body :global(blockquote){
    border-left:3px solid var(--accent);padding-left:20px;margin:var(--space-6) 0;
    font-family:var(--font-display);font-weight:600;font-size:1.15rem;color:var(--text-primary);
  }
  .post-body :global(.table-scroll){overflow-x:auto;margin:var(--space-6) 0;border:1px solid var(--border-subtle);border-radius:var(--radius-md)}
  .post-body :global(table){width:100%;border-collapse:collapse;font-size:.9rem}
  .post-body :global(th),.post-body :global(td){
    padding:12px 16px;text-align:left;border-bottom:1px solid var(--border-subtle);white-space:nowrap;
  }
  .post-body :global(th){
    background:var(--bg-alt);font-family:var(--font-display);font-weight:700;font-size:.78rem;
    letter-spacing:.04em;text-transform:uppercase;color:var(--text-secondary);
  }
  .post-body :global(tr:last-child td){border-bottom:none}

  .post-cta{
    margin-top:var(--space-9);padding:40px;border-radius:var(--radius-lg);
    background:var(--navy-900);color:var(--white);text-align:center;
  }
  .post-cta h3{font-size:1.3rem;margin-bottom:12px;color:var(--white)}
  .post-cta p{color:var(--gray-300);margin-bottom:26px;max-width:440px;margin-inline:auto}
</style>
