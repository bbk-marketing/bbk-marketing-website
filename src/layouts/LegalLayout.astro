---
import Layout from './Layout.astro';
import { site } from '../data/site';

export interface Props {
  title: string;
  description: string;
  effectiveDate: string;
  updatedDate: string;
}

const { title, description, effectiveDate, updatedDate } = Astro.props;
---

<Layout title={`${title} | ${site.name}`} description={description}>
  <article class="legal section">
    <div class="container legal-container">
      <p class="eyebrow">{site.legalName}</p>
      <h1>{title}</h1>
      <p class="legal-dates">Effective Date: {effectiveDate} &middot; Last Updated: {updatedDate}</p>
      <div class="legal-body">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style>
  .legal{padding-top:calc(var(--header-h) + 72px)}
  .legal-container{max-width:820px}
  .legal h1{font-size:var(--fs-h2);margin-bottom:14px}
  .legal-dates{font-size:.86rem;color:var(--gray-500);margin-bottom:var(--space-8)}

  .legal-body :global(h2){
    font-size:1.2rem;margin-top:var(--space-7);margin-bottom:var(--space-3);
    padding-top:var(--space-6);border-top:1px solid var(--border-subtle);
  }
  .legal-body :global(h2:first-child){padding-top:0;border-top:none;margin-top:0}
  .legal-body :global(p){margin-bottom:var(--space-4);line-height:1.75}
  .legal-body :global(ul){display:flex;flex-direction:column;gap:8px;margin:0 0 var(--space-4);padding-left:22px}
  .legal-body :global(li){list-style:disc;line-height:1.65;color:var(--text-secondary)}
  .legal-body :global(a){color:var(--accent-strong);font-weight:600}
  .legal-body :global(a:hover){text-decoration:underline}
  .legal-body :global(strong){color:var(--text-primary)}
</style>
