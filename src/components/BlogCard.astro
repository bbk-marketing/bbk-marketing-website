---
import { formatDate, estimateReadingTime } from '../utils/date';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const readingTime = estimateReadingTime(post.body);
const { heroImage, heroImageAlt, heroImageWidth, heroImageHeight, title } = post.data;
---

<a href={`/blog/${post.slug}`} class:list={['blog-card', { featured }]} data-reveal>
  <div class="blog-card-image">
    {heroImage && (
      <img
        src={heroImage}
        alt={heroImageAlt ?? title}
        loading="lazy"
        width={heroImageWidth}
        height={heroImageHeight}
      />
    )}
  </div>
  <div class="blog-card-body">
    <span class="blog-card-category">{post.data.category}</span>
    <h3>{title}</h3>
    <p>{post.data.description}</p>
    <div class="blog-card-meta">
      <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
      <span aria-hidden="true">&middot;</span>
      <span>{readingTime} min read</span>
    </div>
  </div>
</a>

<style>
  .blog-card{
    display:flex;flex-direction:column;overflow:hidden;
    background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);
    transition:transform .3s var(--ease), box-shadow .3s var(--ease), border-color .3s var(--ease);
  }
  .blog-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-md);border-color:transparent}

  /*
   * These hero images are dense infographics with text to the edge, not
   * candid photography — cropping to a forced ratio cuts off titles/labels.
   * A fixed aspect-ratio box with object-fit:contain keeps every card the
   * same size in the grid without cropping any image, whatever its real
   * dimensions (or no image at all, while one is pending).
   */
  .blog-card-image{
    aspect-ratio:1200/630;overflow:hidden;background:var(--gray-100);
    display:flex;align-items:center;justify-content:center;
  }
  .blog-card-image img{
    width:100%;height:100%;object-fit:contain;display:block;transition:transform .4s var(--ease);
  }
  .blog-card:hover .blog-card-image img{transform:scale(1.04)}

  .blog-card-body{display:flex;flex-direction:column;flex:1;padding:30px 28px}
  .blog-card-category{
    display:inline-block;align-self:flex-start;
    font-family:var(--font-body);font-weight:700;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;
    color:var(--accent-strong);background:var(--royal-100);padding:6px 12px;border-radius:999px;
    margin-bottom:16px;
  }
  .blog-card h3{
    font-size:1.14rem;margin-bottom:10px;line-height:1.3;
    display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;
  }
  .blog-card p{
    font-size:.92rem;line-height:1.6;color:var(--text-secondary);margin-bottom:20px;flex:1;
    display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;
  }
  .blog-card-meta{
    display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--gray-500);font-weight:500;
    padding-top:16px;border-top:1px solid var(--border-subtle);margin-top:auto;
  }

  .blog-card.featured .blog-card-body{padding:38px}
  .blog-card.featured h3{font-size:1.5rem;-webkit-line-clamp:3}

  @media (min-width:760px){
    .blog-card.featured{flex-direction:row;align-items:center}
    .blog-card.featured .blog-card-image{width:48%;aspect-ratio:auto;align-self:stretch}
    .blog-card.featured .blog-card-body{width:52%;justify-content:center}
  }
</style>
