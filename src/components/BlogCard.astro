---
import { formatDate, estimateReadingTime } from '../utils/date';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const readingTime = estimateReadingTime(post.body);
---

<a href={`/blog/${post.slug}`} class:list={['blog-card', { featured }]} data-reveal>
  <span class="blog-card-category">{post.data.category}</span>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <div class="blog-card-meta">
    <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{readingTime} min read</span>
  </div>
</a>

<style>
  .blog-card{
    display:flex;flex-direction:column;
    background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);
    padding:30px 28px;transition:transform .3s var(--ease), box-shadow .3s var(--ease), border-color .3s var(--ease);
  }
  .blog-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-md);border-color:transparent}
  .blog-card-category{
    display:inline-block;align-self:flex-start;
    font-family:var(--font-body);font-weight:700;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;
    color:var(--accent-strong);background:var(--royal-100);padding:6px 12px;border-radius:999px;
    margin-bottom:16px;
  }
  .blog-card h3{font-size:1.14rem;margin-bottom:10px;line-height:1.3}
  .blog-card p{font-size:.92rem;line-height:1.6;color:var(--text-secondary);margin-bottom:20px;flex:1}
  .blog-card-meta{
    display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--gray-500);font-weight:500;
    padding-top:16px;border-top:1px solid var(--border-subtle);
  }

  .blog-card.featured{
    padding:38px;
  }
  .blog-card.featured h3{font-size:1.5rem}
</style>
