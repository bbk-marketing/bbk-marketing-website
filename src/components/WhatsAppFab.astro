---
import { site } from '../data/site';
---

<a
  href={site.waHref}
  target="_blank"
  rel="noopener"
  class="wa-fab"
  aria-label={`Chat with ${site.name} on WhatsApp`}
>
  <span class="ping" aria-hidden="true"></span>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 11.5a8.4 8.4 0 0 1-8.9 8.4 8.5 8.5 0 0 1-4.1-1L3 20l1.1-5a8.3 8.3 0 0 1-1.1-4.2A8.4 8.4 0 0 1 11.9 3a8.5 8.5 0 0 1 8.4 8.5z" />
  </svg>
</a>

<style>
  .wa-fab {
    /* Stacked above Chatwoot's own bubble, which docks bottom-right by
       default (see ChatwootWidget.astro) — this avoids the two floating
       buttons overlapping in that corner. */
    position: fixed;
    bottom: 98px;
    right: 26px;
    z-index: 900;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 26px rgba(37, 211, 102, 0.4);
    transition: transform 0.25s var(--ease);
  }
  .wa-fab:hover {
    transform: scale(1.08);
  }
  .wa-fab svg {
    width: 28px;
    height: 28px;
    color: var(--white);
  }
  .ping {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    opacity: 0.55;
    animation: wa-ping 2.4s ease-out infinite;
  }
  @keyframes wa-ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ping {
      animation: none;
      opacity: 0;
    }
  }
</style>
