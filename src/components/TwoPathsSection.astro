---
import SectionHeader from './SectionHeader.astro';
import { twoPaths } from '../data/twoPaths';
---

<section class="two-paths section section-alt" id="two-paths">
  <div class="container">
    <SectionHeader
      eyebrow="Two Ways to Work With BBK"
      title="Choose the Recruitment Model That Fits Your Organization."
      center
    />
    <div class="paths-grid">
      {twoPaths.map((p, i) => (
        <div class:list={['path-card', { featured: p.featured }]} data-reveal data-reveal-delay={String(i + 1)}>
          <span class="path-eyebrow">{p.eyebrow}</span>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <ul>
            {p.bullets.map((b) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <a href={p.ctaHref} class:list={['btn', p.featured ? 'btn-primary' : 'btn-outline']}>{p.ctaLabel}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .paths-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  @media (max-width:820px){.paths-grid{grid-template-columns:1fr}}

  .path-card{
    background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);
    padding:40px 34px;display:flex;flex-direction:column;
  }
  .path-card.featured{
    background:var(--navy-900);color:var(--white);border-color:transparent;
    box-shadow:var(--shadow-lg);
    position:relative;
  }
  .path-card.featured::before{
    content:"";position:absolute;inset:0;border-radius:var(--radius-lg);padding:1.5px;
    background:linear-gradient(135deg, var(--cyan-400), var(--royal-500));
    -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite:xor;mask-composite:exclude;
    pointer-events:none;
  }
  .path-card.featured p{color:var(--gray-300)}
  .path-card.featured li{color:var(--gray-300)}
  .path-card.featured li svg{color:var(--cyan-400)}

  .path-eyebrow{
    font-weight:700;font-size:.76rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-strong);
    margin-bottom:12px;
  }
  .path-card.featured .path-eyebrow{color:var(--cyan-400)}
  .path-card h3{font-size:1.3rem;margin-bottom:12px}
  .path-card p{margin-bottom:22px;line-height:1.65}
  .path-card ul{display:flex;flex-direction:column;gap:11px;margin-bottom:28px;flex:1}
  .path-card li{display:flex;align-items:flex-start;gap:10px;font-size:.92rem;font-weight:500}
  .path-card li svg{width:16px;height:16px;color:var(--accent-strong);margin-top:3px;flex-shrink:0}
  .path-card .btn{align-self:flex-start}
</style>
