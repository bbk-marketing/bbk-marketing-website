---
import { participantJourney } from '../data/participantJourney';
---

<div class="journey" data-reveal>
  {participantJourney.map((step, i) => (
    <>
      <div class="journey-step">
        <span class="step-index">{String(i + 1).padStart(2, '0')}</span>
        <span class="step-label">{step}</span>
      </div>
      {i < participantJourney.length - 1 && (
        <div class="journey-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </div>
      )}
    </>
  ))}
</div>

<style>
  .journey{
    display:flex;align-items:center;flex-wrap:wrap;gap:10px 6px;
    padding:28px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);
    border-radius:var(--radius-lg);
  }
  .journey-step{
    display:flex;flex-direction:column;gap:4px;
    background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);
    border-radius:var(--radius-sm);padding:12px 16px;min-width:118px;
  }
  .step-index{font-family:var(--font-display);font-size:.7rem;font-weight:700;color:var(--cyan-400)}
  .step-label{font-size:.86rem;font-weight:600;color:var(--white)}
  .journey-arrow{color:var(--gray-500);flex-shrink:0}
  .journey-arrow svg{width:18px;height:18px}

  @media (max-width:720px){
    .journey{flex-direction:column;align-items:stretch}
    .journey-step{min-width:0}
    .journey-arrow{transform:rotate(90deg);align-self:center}
  }
</style>
