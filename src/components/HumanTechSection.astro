---
import SectionHeader from './SectionHeader.astro';

const techItems = ['Immediate acknowledgment', 'Reminders', 'Routing', 'Administrative communication', 'Workflow efficiency'];
const humanItems = ['Participant engagement', 'Assisted pre-screening', 'Campaign development', 'Sensitive interactions', 'Recruitment support'];
---

<section class="human-tech section" id="human-tech">
  <div class="container">
    <SectionHeader
      eyebrow="How We Work"
      title="Technology Where It Helps. Humans Where They Matter."
      center
    />
    <div class="ht-grid">
      <div class="ht-card" data-reveal>
        <div class="ht-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="16" height="16" rx="4"/><path d="M9 9h.01M15 9h.01M9 15c1 1 5 1 6 0"/></svg>
        </div>
        <h3>Automation &amp; AI</h3>
        <ul>{techItems.map((i) => <li>{i}</li>)}</ul>
      </div>

      <div class="ht-connector" aria-hidden="true">
        <svg viewBox="0 0 60 24"><path d="M2 12h56M46 4l10 8-10 8" stroke="var(--gray-300)" stroke-width="2" fill="none"/></svg>
      </div>

      <div class="ht-card featured" data-reveal data-reveal-delay="2">
        <div class="ht-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="18" cy="7" r="2.4"/><path d="M15.5 13.5c2.6.3 4.5 2.5 4.5 5.2"/></svg>
        </div>
        <h3>Human Recruitment Team</h3>
        <ul>{humanItems.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
    <p class="ht-result">→ Better Participant Experience.</p>
  </div>
</section>

<style>
  .ht-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:18px;align-items:stretch}
  @media (max-width:820px){
    .ht-grid{grid-template-columns:1fr}
    .ht-connector{transform:rotate(90deg);justify-self:center}
  }
  .ht-card{
    background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);
    padding:32px 28px;
  }
  .ht-card.featured{background:var(--navy-900);color:var(--white);border-color:transparent}
  .ht-card.featured li{color:var(--gray-300)}
  .ht-icon{
    width:48px;height:48px;border-radius:12px;background:var(--royal-100);color:var(--accent-strong);
    display:flex;align-items:center;justify-content:center;margin-bottom:18px;
  }
  .ht-card.featured .ht-icon{background:rgba(56,217,240,.14);color:var(--cyan-400)}
  .ht-icon svg{width:22px;height:22px}
  .ht-card h3{font-size:1.1rem;margin-bottom:16px}
  .ht-card ul{display:flex;flex-direction:column;gap:10px}
  .ht-card li{font-size:.9rem;font-weight:500;position:relative;padding-left:16px}
  .ht-card li::before{content:"";position:absolute;left:0;top:9px;width:6px;height:6px;border-radius:50%;background:var(--accent)}
  .ht-card.featured li::before{background:var(--cyan-400)}
  .ht-connector{display:flex;align-items:center;justify-content:center}
  .ht-connector svg{width:44px;height:20px}
  .ht-result{
    text-align:center;margin-top:30px;font-family:var(--font-display);font-weight:700;font-size:1.15rem;
    color:var(--accent-strong);
  }
</style>
