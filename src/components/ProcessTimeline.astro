---
import SectionHeader from './SectionHeader.astro';
import { processSteps } from '../data/process';
---

<section class="process section" id="our-process">
  <div class="container">
    <SectionHeader
      eyebrow="Our Process"
      title="From Study to Recruitment Campaign"
      description="A simple, sequential process — from Study intake to a live recruitment campaign, with regulatory review built in rather than bolted on."
      center
    />
    <ol class="process-list">
      {processSteps.map((step, i) => (
        <li class="process-item" data-reveal data-reveal-delay={String((i % 4) + 1)}>
          <span class="process-number">{step.number}</span>
          <div class="process-content">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-list{
    max-width:800px;margin-inline:auto;
    display:flex;flex-direction:column;
  }
  .process-item{
    display:grid;grid-template-columns:64px 1fr;gap:24px;align-items:start;
    padding:28px 0;border-bottom:1px solid var(--border-subtle);
  }
  .process-item:last-child{border-bottom:none}
  .process-number{
    font-family:var(--font-display);font-weight:800;font-size:1.6rem;line-height:1;
    color:transparent;background:linear-gradient(135deg, var(--cyan-400), var(--royal-500));
    -webkit-background-clip:text;background-clip:text;
  }
  .process-content h3{font-size:1.08rem;margin-bottom:6px}
  .process-content p{font-size:.94rem;line-height:1.65;color:var(--text-secondary)}

  @media (max-width:560px){
    .process-item{grid-template-columns:44px 1fr;gap:16px}
    .process-number{font-size:1.25rem}
  }
</style>
