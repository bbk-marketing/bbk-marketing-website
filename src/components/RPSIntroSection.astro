---
import { site } from '../data/site';
---

<section class="rps-intro section" id="rps-intro">
  <div class="container rps-grid">
    <div data-reveal>
      <div class="eyebrow">{site.rps.shortName}</div>
      <h2>Advertising Gets Attention. Recruitment Requires More.</h2>
      <p class="body">
        Traditional digital campaigns can generate interest. {site.rps.shortName} is being designed
        to take the process further — helping research organizations manage participant engagement,
        preliminary pre-screening and referral workflows through a dedicated recruitment environment.
      </p>
      <a href="#patient-recruitment" class="btn btn-primary">Discover {site.rps.shortName}</a>
    </div>

    <div class="rps-teaser-visual" data-reveal data-reveal-delay="2">
      <div class="teaser-card">
        <div class="teaser-hub">{site.rps.shortName}</div>
        <div class="teaser-side left">
          <span class="teaser-label">Participants</span>
        </div>
        <div class="teaser-side right">
          <span class="teaser-label">Recruiters</span>
        </div>
        <svg class="teaser-lines" viewBox="0 0 320 160" preserveAspectRatio="none">
          <path d="M60 80 C 100 80, 120 80, 150 80" stroke="var(--cyan-400)" stroke-width="2" fill="none" stroke-dasharray="4 6"/>
          <path d="M170 80 C 200 80, 220 80, 260 80" stroke="var(--royal-400)" stroke-width="2" fill="none" stroke-dasharray="4 6"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .rps-intro{background:var(--bg-alt)}
  .rps-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
  @media (max-width:900px){.rps-grid{grid-template-columns:1fr}}

  .rps-intro h2{font-size:var(--fs-h2);margin-bottom:18px}
  .rps-intro .body{font-size:var(--fs-lead);line-height:1.7;margin-bottom:30px;max-width:560px}

  .teaser-card{
    position:relative;background:var(--navy-900);border-radius:var(--radius-lg);
    padding:48px 24px;min-height:220px;
    display:flex;align-items:center;justify-content:center;
    box-shadow:var(--shadow-lg);
  }
  .teaser-hub{
    position:relative;z-index:2;
    background:var(--white);color:var(--navy-900);
    font-family:var(--font-display);font-weight:800;font-size:.92rem;
    padding:14px 20px;border-radius:var(--radius-sm);
    box-shadow:0 12px 28px rgba(0,0,0,.28);
  }
  .teaser-side{
    position:absolute;top:50%;transform:translateY(-50%);
    background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);
    border-radius:var(--radius-sm);padding:10px 16px;
  }
  .teaser-side.left{left:16px}
  .teaser-side.right{right:16px}
  .teaser-label{
    font-family:var(--font-body);font-weight:700;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;
    color:var(--gray-300);
  }
  .teaser-lines{position:absolute;inset:0;width:100%;height:100%;z-index:1}
</style>
