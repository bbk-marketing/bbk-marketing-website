---
import SectionHeader from './SectionHeader.astro';
import { site } from '../data/site';
---

<section class="ecosystem section section-dark" id="ecosystem">
  <div class="container">
    <SectionHeader
      eyebrow="The BBK Ecosystem"
      title="An Integrated Growth and Recruitment Ecosystem for Clinical Research."
      center
    />
    <div class="eco-grid" data-reveal>
      <div class="eco-card">
        <h3>{site.name}</h3>
        <ul>
          <li>Marketing</li>
          <li>Creative</li>
          <li>Business Growth</li>
          <li>Advertising Strategy</li>
        </ul>
      </div>

      <div class="eco-connector" aria-hidden="true">
        <svg viewBox="0 0 60 24"><path d="M2 12h56" stroke="var(--gray-500)" stroke-width="2" stroke-dasharray="4 6"/></svg>
      </div>

      <div class="eco-card featured">
        <h3>{site.rps.name}</h3>
        <ul>
          <li>Participant Recruitment</li>
          <li>Pre-Screening</li>
          <li>Referral Management</li>
          <li>Recruitment Technology</li>
        </ul>
      </div>
    </div>
    <p class="eco-note">
      {site.name} and {site.rps.shortName} work together but operate as separate organizations —
      see the footer for the full legal distinction.
    </p>
  </div>
</section>

<style>
  .eco-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center}
  @media (max-width:820px){
    .eco-grid{grid-template-columns:1fr}
    .eco-connector{transform:rotate(90deg);justify-self:center}
  }
  .eco-card{
    background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);
    border-radius:var(--radius-lg);padding:32px 28px;
  }
  .eco-card.featured{border-color:var(--cyan-400);background:rgba(56,217,240,.06)}
  .eco-card h3{font-size:1.1rem;margin-bottom:18px;color:var(--white)}
  .eco-card ul{display:flex;flex-direction:column;gap:10px}
  .eco-card li{font-size:.9rem;color:var(--gray-300);font-weight:500}
  .eco-connector svg{width:44px;height:20px}
  .eco-note{text-align:center;margin-top:30px;font-size:.86rem;color:var(--gray-500);max-width:560px;margin-inline:auto}
</style>
