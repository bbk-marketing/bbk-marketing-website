---
import { selfAssessmentCategories, TIER_COLOR, TIER_LABEL } from '../data/selfAssessment';
import { site } from '../data/site';

const orgTypes = ['Research Site', 'CRO', 'SMO', 'Sponsor', 'Other'];
const totalQuestions = selfAssessmentCategories.reduce((n, c) => n + c.questions.length, 0);
---

<div class="saq" id="saq" data-total={totalQuestions}>
  <!-- STEP 1: Quiz -->
  <div class="saq-step" id="saq-step-quiz">
    <div class="saq-progress">
      <div class="saq-progress-track"><div class="saq-progress-fill" id="saq-progress-fill"></div></div>
      <span id="saq-progress-label">0 of {totalQuestions} answered</span>
    </div>

    {selfAssessmentCategories.map((category) => (
      <fieldset class="saq-category" data-reveal>
        <legend>{category.name}</legend>
        {category.questions.map((q) => (
          <div class="saq-question" data-question={q.id}>
            <p class="saq-question-text">{q.text}</p>
            <div class="saq-scale" role="radiogroup">
              {[1, 2, 3, 4, 5].map((v) => (
                <label class="saq-scale-opt">
                  <input type="radio" name={q.id} value={v} />
                  <span>{v}</span>
                </label>
              ))}
            </div>
            <div class="saq-scale-labels"><span>Strongly Disagree</span><span>Strongly Agree</span></div>
          </div>
        ))}
      </fieldset>
    ))}

    <button type="button" class="btn btn-primary btn-full" id="saq-continue" disabled>
      Continue to Get My Results
    </button>
    <p class="saq-hint" id="saq-hint">Answer every statement above to continue.</p>
  </div>

  <!-- STEP 2: Business info + consent -->
  <div class="saq-step" id="saq-step-info" hidden>
    <h3>Almost there — where should we send your results?</h3>
    <p class="saq-step-lead">
      Your responses stay private. We'll use this information to send your personalized results and, only if
      you agree below, to follow up about how BBK can help.
    </p>

    <form id="saq-form" novalidate>
      <div class="form-row">
        <div class="field">
          <label for="saq-org">Organization Name</label>
          <input id="saq-org" name="organizationName" type="text" required placeholder="Research Site / CRO / SMO name" />
        </div>
        <div class="field">
          <label for="saq-orgType">Organization Type</label>
          <select id="saq-orgType" name="orgType">
            {orgTypes.map((o) => <option>{o}</option>)}
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label for="saq-firstName">First Name</label>
          <input id="saq-firstName" name="firstName" type="text" placeholder="Jane" />
        </div>
        <div class="field">
          <label for="saq-lastName">Last Name</label>
          <input id="saq-lastName" name="lastName" type="text" placeholder="Smith" />
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label for="saq-email">Business Email</label>
          <input id="saq-email" name="email" type="email" required placeholder="you@organization.com" />
        </div>
        <div class="field">
          <label for="saq-phone">Phone</label>
          <input id="saq-phone" name="phone" type="tel" placeholder="+1 (555) 000-0000" />
        </div>
      </div>

      <div class="field">
        <label for="saq-postal">ZIP / Postal Code</label>
        <input id="saq-postal" name="postalCode" type="text" placeholder="34135" />
      </div>

      <label class="consent-field">
        <input id="saq-consent" type="checkbox" name="consent" required />
        <span>
          By checking this box, I consent to receive my results and follow-up communication — by email, phone
          call, and text message — from {site.legalName} regarding this self-assessment. Reply STOP to opt out
          of texts. Reply HELP for help. Standard message and data rates may apply. View our
          <a href="/terms-and-conditions" target="_blank" rel="noopener">Terms &amp; Conditions</a> and
          <a href="/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>.
        </span>
      </label>

      <button type="submit" class="btn btn-primary btn-full" id="saq-submit">Get My Results</button>
      <p class="saq-error" id="saq-error" hidden></p>
    </form>
  </div>

  <!-- STEP 3: Results -->
  <div class="saq-step" id="saq-step-result" hidden>
    <div class="saq-result-badge">
      <div class="saq-result-pct" id="saq-result-pct">—</div>
      <div class="saq-result-label" id="saq-result-label">—</div>
    </div>
    <div class="saq-result-breakdown" id="saq-result-breakdown"></div>
    <p class="saq-result-emailed" id="saq-result-emailed" hidden>
      We've also emailed a copy of your results.
    </p>
    <p class="saq-result-cta">
      Want to talk through what these results mean for your organization?
      <a href="/#contact" class="btn btn-outline btn-sm">Request a Consultation</a>
    </p>
  </div>
</div>

<script define:vars={{ categories: selfAssessmentCategories, tierColor: TIER_COLOR, tierLabel: TIER_LABEL }}>
  const root = document.getElementById('saq');
  const total = Number(root.dataset.total);

  const stepQuiz = document.getElementById('saq-step-quiz');
  const stepInfo = document.getElementById('saq-step-info');
  const stepResult = document.getElementById('saq-step-result');

  const progressFill = document.getElementById('saq-progress-fill');
  const progressLabel = document.getElementById('saq-progress-label');
  const continueBtn = document.getElementById('saq-continue');
  const hint = document.getElementById('saq-hint');

  function answeredCount() {
    return categories.reduce((sum, cat) => sum + cat.questions.filter((q) => root.querySelector(`input[name="${q.id}"]:checked`)).length, 0);
  }

  function updateProgress() {
    const count = answeredCount();
    progressFill.style.width = `${(count / total) * 100}%`;
    progressLabel.textContent = `${count} of ${total} answered`;
    const complete = count === total;
    continueBtn.disabled = !complete;
    hint.textContent = complete ? 'All set — you can continue.' : 'Answer every statement above to continue.';
  }

  root.addEventListener('change', (e) => {
    if (e.target instanceof HTMLInputElement && e.target.type === 'radio') updateProgress();
  });
  updateProgress();

  continueBtn.addEventListener('click', () => {
    stepQuiz.hidden = true;
    stepInfo.hidden = false;
    stepInfo.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  const form = document.getElementById('saq-form');
  const submitBtn = document.getElementById('saq-submit');
  const errorEl = document.getElementById('saq-error');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;

    const answers = {};
    for (const cat of categories) {
      for (const q of cat.questions) {
        const checked = root.querySelector(`input[name="${q.id}"]:checked`);
        answers[q.id] = checked ? Number(checked.value) : 0;
      }
    }
    const categoryScores = categories.map((cat) => ({
      name: cat.name,
      score: cat.questions.reduce((s, q) => s + (answers[q.id] || 0), 0),
      max: cat.questions.length * 5,
    }));
    const rawScore = categoryScores.reduce((s, c) => s + c.score, 0);
    const percentage = (rawScore / (total * 5)) * 100;

    const data = new FormData(form);
    const get = (k) => (data.get(k) || '').toString().trim();
    const consented = document.getElementById('saq-consent').checked;

    const payload = {
      organizationName: get('organizationName'),
      firstName: get('firstName') || undefined,
      lastName: get('lastName') || undefined,
      email: get('email'),
      phone: get('phone') || undefined,
      postalCode: get('postalCode') || undefined,
      score: percentage,
      categories: categoryScores,
      consent: { email: consented, calls: consented, sms: consented },
      answers,
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    try {
      const res = await fetch('/api/self-assessment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('Submission failed');
      const result = await res.json();

      const tier = result.tier || 'orange';
      const pct = Math.round(result.percentage ?? percentage);

      document.getElementById('saq-result-pct').textContent = `${pct}%`;
      document.getElementById('saq-result-pct').style.color = tierColor[tier];
      document.getElementById('saq-result-label').textContent = tierLabel[tier];
      document.getElementById('saq-result-label').style.color = tierColor[tier];

      const breakdown = document.getElementById('saq-result-breakdown');
      breakdown.innerHTML = categoryScores
        .map((c) => {
          const p = Math.round((c.score / c.max) * 100);
          return `<div class="saq-bar-row">
            <span class="saq-bar-name">${c.name}</span>
            <div class="saq-bar-track"><div class="saq-bar-fill" style="width:${p}%;background:${tierColor[tier]}"></div></div>
            <span class="saq-bar-score">${c.score}/${c.max}</span>
          </div>`;
        })
        .join('');

      document.getElementById('saq-result-emailed').hidden = !consented;

      stepInfo.hidden = true;
      stepResult.hidden = false;
      stepResult.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch {
      errorEl.textContent = 'Something went wrong submitting your assessment. Please try again.';
      errorEl.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Get My Results';
    }
  });
</script>

<style>
  .saq{max-width:760px;margin-inline:auto}
  .saq-progress{margin-bottom:var(--space-7)}
  .saq-progress-track{height:8px;border-radius:6px;background:var(--gray-100);overflow:hidden;margin-bottom:8px}
  .saq-progress-fill{height:100%;background:var(--accent);border-radius:6px;transition:width .3s var(--ease);width:0}
  #saq-progress-label{font-size:.85rem;color:var(--text-secondary);font-weight:600}

  .saq-category{border:none;padding:0;margin:0 0 var(--space-8)}
  .saq-category legend{
    font-family:var(--font-display);font-weight:700;font-size:var(--fs-h3);
    color:var(--text-primary);margin-bottom:var(--space-5);padding:0;
  }
  .saq-question{margin-bottom:var(--space-6);padding-bottom:var(--space-5);border-bottom:1px solid var(--border-subtle)}
  .saq-question:last-child{border-bottom:none}
  .saq-question-text{font-weight:600;color:var(--text-primary);margin-bottom:14px;line-height:1.5}

  .saq-scale{display:flex;gap:10px;margin-bottom:6px}
  .saq-scale-opt{
    flex:1;display:flex;align-items:center;justify-content:center;
    height:44px;border-radius:var(--radius-sm);border:1.5px solid var(--gray-300);
    cursor:pointer;font-weight:700;color:var(--text-secondary);
    transition:border-color .2s var(--ease), background-color .2s var(--ease), color .2s var(--ease);
  }
  .saq-scale-opt input{position:absolute;opacity:0;width:1px;height:1px}
  .saq-scale-opt:has(input:checked){background:var(--accent);border-color:var(--accent);color:var(--white)}
  .saq-scale-opt:has(input:focus-visible){outline:2.5px solid var(--accent);outline-offset:2px}
  .saq-scale-labels{display:flex;justify-content:space-between;font-size:.78rem;color:var(--gray-500)}

  .saq-hint{text-align:center;font-size:.85rem;color:var(--gray-500);margin-top:12px}
  .btn-full{width:100%}
  .btn[disabled]{opacity:.5;cursor:not-allowed;pointer-events:none}

  #saq-step-info h3{font-size:var(--fs-h2);margin-bottom:12px}
  .saq-step-lead{margin-bottom:var(--space-6);font-size:1rem;line-height:1.65}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
  @media (max-width:540px){.form-row{grid-template-columns:1fr}}
  .field{display:flex;flex-direction:column;gap:7px;margin-bottom:16px}
  .field label{font-size:.8rem;font-weight:600;color:var(--gray-600)}
  .field input,.field select{
    padding:13px 15px;border-radius:10px;border:1.5px solid var(--gray-300);
    background:var(--white);color:var(--text-primary);font-size:.92rem;
    transition:border-color .2s var(--ease), box-shadow .2s var(--ease);
  }
  .field input:focus,.field select:focus{
    outline:none;border-color:var(--accent);box-shadow:0 0 0 4px var(--royal-100);
  }

  .consent-field{display:flex;align-items:flex-start;gap:12px;margin-bottom:22px;cursor:pointer}
  .consent-field input[type="checkbox"]{
    appearance:none;-webkit-appearance:none;flex-shrink:0;
    width:19px;height:19px;margin-top:2px;border-radius:5px;
    border:1.5px solid var(--gray-300);background:var(--white);
    cursor:pointer;position:relative;
    transition:border-color .2s var(--ease), background-color .2s var(--ease);
  }
  .consent-field input[type="checkbox"]:checked{background:var(--accent);border-color:var(--accent)}
  .consent-field input[type="checkbox"]:checked::after{
    content:"";position:absolute;left:5px;top:1px;width:5px;height:9px;
    border:solid var(--white);border-width:0 2px 2px 0;transform:rotate(45deg);
  }
  .consent-field input[type="checkbox"]:focus-visible{outline:2.5px solid var(--accent);outline-offset:2px}
  .consent-field span{font-size:.8rem;line-height:1.55;color:var(--text-secondary)}
  .consent-field a{color:var(--accent-strong);font-weight:600}
  .consent-field a:hover{text-decoration:underline}

  .saq-error{color:#c00000;font-size:.86rem;margin-top:12px;font-weight:600}

  .saq-result-badge{text-align:center;padding:var(--space-7) 0;margin-bottom:var(--space-6)}
  .saq-result-pct{font-family:var(--font-display);font-size:clamp(3rem,2.5rem+2vw,4.5rem);font-weight:800;line-height:1}
  .saq-result-label{font-weight:700;font-size:1.1rem;margin-top:8px}
  .saq-result-breakdown{display:flex;flex-direction:column;gap:16px;margin-bottom:var(--space-6)}
  .saq-bar-row{display:grid;grid-template-columns:1fr 2fr auto;gap:12px;align-items:center}
  .saq-bar-name{font-size:.88rem;font-weight:600;color:var(--text-primary)}
  .saq-bar-track{height:8px;border-radius:6px;background:var(--gray-100);overflow:hidden}
  .saq-bar-fill{height:100%;border-radius:6px}
  .saq-bar-score{font-size:.82rem;color:var(--gray-500);text-align:right;white-space:nowrap}
  .saq-result-emailed{text-align:center;font-size:.9rem;color:var(--gray-600);margin-bottom:var(--space-5)}
  .saq-result-cta{text-align:center;font-size:1rem;display:flex;flex-direction:column;align-items:center;gap:16px}
</style>
