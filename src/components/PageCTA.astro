---
export interface Props {
  heading: string;
  body: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const { heading, body, ctaLabel = 'Request a Consultation', ctaHref = '/#contact' } = Astro.props;
---

<section class="page-cta section">
  <div class="container page-cta-inner" data-reveal>
    <h2>{heading}</h2>
    <p>{body}</p>
    <a href={ctaHref} class="btn btn-primary">{ctaLabel}</a>
  </div>
</section>

<style>
  .page-cta{background:var(--navy-900);color:var(--white)}
  .page-cta-inner{max-width:640px;margin-inline:auto;text-align:center}
  .page-cta h2{font-size:var(--fs-h2);margin-bottom:14px;color:var(--white)}
  .page-cta p{font-size:1.02rem;line-height:1.7;color:var(--gray-300);margin-bottom:28px}
</style>
