---
export interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  center?: boolean;
}
const { eyebrow, title, description, center = false } = Astro.props;
---

<div class:list={['section-head', { center }]} data-reveal>
  <div class="eyebrow">{eyebrow}</div>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</div>
