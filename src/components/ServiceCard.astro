---
import type { Service } from '../data/services';

export interface Props { service: Service }
const { service } = Astro.props;

const icons: Record<Service['icon'], string> = {
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/>',
  creative: '<rect x="3" y="5" width="14" height="11" rx="2"/><path d="M17 9l4-2.5v11L17 15"/>',
  growth: '<path d="M4 19h16M6 15l4-5 3 3 5-7"/>',
  rps: '<circle cx="7" cy="8" r="2.6"/><circle cx="17" cy="8" r="2.6"/><path d="M4.5 19c0-3 2.5-5.4 5.6-5.4M19.5 19c0-3-2.5-5.4-5.6-5.4"/><path d="M12 12v4M10 18h4"/>',
};
---

<article class:list={['service-card', { featured: service.featured }]} data-reveal>
  <span class="num">{service.number}</span>
  <div class="service-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">${icons[service.icon]}</svg>`} />
  <h3>{service.title}</h3>
  <p>{service.description}</p>
  <ul class="service-list">
    {service.bullets.map((b) => (
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
        <span>{b}</span>
      </li>
    ))}
  </ul>
  <a href={service.ctaHref} class="service-cta">{service.ctaLabel} →</a>
</article>

<style>
  .service-card{
    position:relative;background:var(--white);border:1px solid var(--border-subtle);
    border-radius:var(--radius-lg);padding:34px 28px;
    display:flex;flex-direction:column;
    transition:transform .3s var(--ease), box-shadow .3s var(--ease), border-color .3s var(--ease);
  }
  .service-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-md);border-color:transparent}
  .service-card.featured{
    background:var(--navy-900);color:var(--white);border-color:transparent;
  }
  .service-card.featured p{color:var(--gray-300)}
  .service-card.featured .service-list li{color:var(--gray-300)}
  .service-card.featured .service-list svg{color:var(--cyan-400)}
  .service-card.featured .num{color:rgba(255,255,255,.25)}

  .num{position:absolute;top:26px;right:28px;font-family:var(--font-display);font-weight:700;font-size:.78rem;color:var(--gray-300)}
  .service-icon{
    width:52px;height:52px;border-radius:14px;background:var(--royal-100);color:var(--accent-strong);
    display:flex;align-items:center;justify-content:center;margin-bottom:22px;
  }
  .service-card.featured .service-icon{background:rgba(56,217,240,.14);color:var(--cyan-400)}
  .service-icon svg{width:24px;height:24px}
  .service-card h3{font-size:1.16rem;margin-bottom:10px}
  .service-card p{font-size:.92rem;line-height:1.6;margin-bottom:18px}
  .service-list{display:flex;flex-direction:column;gap:9px;margin-bottom:22px;flex:1}
  .service-list li{display:flex;align-items:flex-start;gap:9px;font-size:.86rem;font-weight:500;color:var(--text-primary)}
  .service-list svg{width:15px;height:15px;color:var(--accent-strong);margin-top:3px;flex-shrink:0}
  .service-cta{font-weight:700;font-size:.88rem;color:var(--accent-strong)}
  .service-card.featured .service-cta{color:var(--cyan-400)}
</style>
