---
import { navItems, primaryCta } from '../data/nav';
import { site } from '../data/site';
---

<header class="nav" id="siteNav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <img src="/logo.png" alt={site.name} width="140" height="46" />
    </a>

    <nav class="nav-links" id="navLinks" aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href={primaryCta.href} class="btn btn-primary btn-sm nav-cta">{primaryCta.label}</a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  /*
   * Fail-safe by default: the nav is solid and readable everywhere. It only
   * earns the transparent-over-hero look at scroll-top when BOTH conditions
   * hold: JS confirmed it's running (html.js-reveal) AND the page declared
   * it actually has a dark hero behind the nav (data-transparent-nav="true",
   * set via Layout's transparentNavAtTop prop — homepage only). Without the
   * second check, a page with a light background at the top (blog, legal)
   * would get white-on-white nav text the moment JS happened to run.
   */
  .nav{
    position:fixed;inset-inline:0;top:0;z-index:1000;
    height:72px;display:flex;align-items:center;
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid var(--border-subtle);
    box-shadow:var(--shadow-sm);
    transition:background-color .3s var(--ease), border-color .3s var(--ease), box-shadow .3s var(--ease), height .3s var(--ease);
  }
  :global(html.js-reveal[data-transparent-nav="true"]) .nav:not(.is-scrolled){
    height:var(--header-h);
    background:transparent;
    border-bottom-color:transparent;
    box-shadow:none;
  }
  .nav-inner{display:flex;align-items:center;justify-content:space-between;gap:24px}
  .brand img{height:34px;width:auto}

  .nav-links{display:flex;align-items:center;gap:30px}
  .nav-links a{
    font-weight:600;font-size:.9rem;color:var(--text-primary);
    position:relative;padding:6px 0;transition:color .25s var(--ease);
  }
  :global(html.js-reveal[data-transparent-nav="true"]) .nav:not(.is-scrolled) .nav-links a{color:var(--text-on-dark)}
  .nav-links a::after{
    content:"";position:absolute;left:0;bottom:0;width:0;height:2px;
    background:var(--accent);transition:width .25s var(--ease);border-radius:2px;
  }
  .nav-links a:hover::after{width:100%}

  .nav-actions{display:flex;align-items:center;gap:14px}
  .nav-toggle{display:none;flex-direction:column;gap:5px;width:26px;padding:4px}
  .nav-toggle span{
    height:2px;background:var(--text-primary);border-radius:2px;transition:all .25s var(--ease);
  }
  :global(html.js-reveal[data-transparent-nav="true"]) .nav:not(.is-scrolled) .nav-toggle span{background:var(--text-on-dark)}

  @media (max-width:960px){
    .nav-links{
      position:fixed;top:var(--header-h);left:0;right:0;bottom:0;
      background:var(--white);flex-direction:column;align-items:flex-start;
      padding:28px 24px;gap:4px;
      transform:translateX(100%);transition:transform .35s var(--ease);
      overflow-y:auto;
    }
    .nav-links.is-open{transform:translateX(0)}
    .nav-links a{width:100%;padding:16px 4px;border-bottom:1px solid var(--border-subtle);color:var(--text-primary) !important;font-size:1.02rem}
    .nav-cta{display:none}
    .nav-toggle{display:flex}
  }
  .nav-toggle.is-open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .nav-toggle.is-open span:nth-child(2){opacity:0}
  .nav-toggle.is-open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
</style>

<script>
  const nav = document.getElementById('siteNav');
  const toggle = document.getElementById('navToggle');
  const links = document.getElementById('navLinks');

  const onScroll = () => {
    nav?.classList.toggle('is-scrolled', window.scrollY > 12);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('is-open');
    toggle.classList.toggle('is-open', !!isOpen);
    toggle.setAttribute('aria-expanded', String(!!isOpen));
  });

  links?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      links.classList.remove('is-open');
      toggle?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
